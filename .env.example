# Copy to .env and fill in. Real environment variables override this file.

ADDR=:8080
STATIC_DIR=web/dist
DATABASE_PATH=video-queue.db

# Discord application (https://discord.com/developers/applications)
# OAuth2: client ID and secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must also be added under OAuth2 -> Redirects. In dev this goes through the Vite proxy.
DISCORD_REDIRECT_URL=http://localhost:5173/api/auth/callback

# Bot: reads suggestion channels, lists roles/channels, checks mod roles.
# Enable the Message Content intent and invite the bot to every streamer's server.
DISCORD_BOT_TOKEN=

# Optional: your Discord user ID (comma-separated for several). Admins can add,
# configure and see every server, even without Manage Server on it. Required
# only when SELF_REGISTRATION=false.
APP_ADMIN_USER_IDS=

# Let streamers (owners / Manage Server on their Discord server) register their
# own servers. Set to false to allow only app admins.
SELF_REGISTRATION=true

# Set to true when served over HTTPS
COOKIE_SECURE=false
SESSION_TTL=168h
# How long a mod-role check is trusted before asking Discord again
ACCESS_CACHE_TTL=10m
SUGGESTIONS_POLL_INTERVAL=2m

# Optional: YouTube Data API v3 key (Google Cloud console -> APIs & Services ->
# enable "YouTube Data API v3" -> Credentials -> API key). Enables fetching
# video details and importing series from playlists. Thumbnails work without it.
YOUTUBE_API_KEY=

# Optional: Twitch application (https://dev.twitch.tv/console/apps -> Register
# Your Application; any OAuth redirect URL, category "Other"). Enables looking up
# clips shared in a server's clips channel: title, who clipped it, thumbnail, length.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
